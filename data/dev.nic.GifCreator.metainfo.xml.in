<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Nic -->
<component type="desktop-application">
  <id>@app_id@</id>
  <name>Psychedelic GIF Creator@name_suffix@</name>
  <summary>Turn still images into looping psychedelic GIFs</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <content_rating type="oars-1.1" />
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name>Nic</developer_name>
  <developer id="dev.nic">
    <name>Nic</name>
  </developer>
  <description>
    <p>
      Psychedelic GIF Creator turns a still image into a seamlessly looping animated GIF with
      kaleidoscope, star field, wave and colour effects.
    </p>
  </description>
  <releases>
    <release version="0.1.0" date="2026-11-01">
      <description>
        <p>Application skeleton and Flatpak packaging.</p>
      </description>
    </release>
  </releases>
</component>
