<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="dev.nic.GifCreator" path="/dev/nic/GifCreator/">
    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>760</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="last-open-dir" type="s">
      <default>''</default>
      <summary>Folder of the last image opened</summary>
    </key>
    <key name="last-save-dir" type="s">
      <default>''</default>
      <summary>Folder the last GIF was saved to</summary>
    </key>
  </schema>
</schemalist>
